<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#FFF5F7">
<title>Tower Bloxx LynkID — Prototype</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Baloo+2:wght@400;500;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --lavender: #B794F6;
    --lavender-deep: #805AD5;
    --lavender-soft: #E9D8FD;
    --lavender-faint: #FAF5FF;
    --pink: #FBB6CE;
    --pink-deep: #ED64A6;
    --pink-soft: #FED7E2;
    --mint: #9AE6B4;
    --mint-deep: #38B2AC;
    --peach: #FBD38D;
    --peach-deep: #D69E2E;
    --sky: #BEE3F8;
    --sky-deep: #3182CE;
    --cream: #FFF5F7;
    --cream-2: #FFFAF0;
    --ink: #2D3748;
    --ink-soft: #4A5568;
    --ink-mute: #718096;
    --gray-100: #F7FAFC;
    --gray-200: #EDF2F7;
    --gray-300: #E2E8F0;
    --white: #FFFFFF;
    --shadow-xs: 0 1px 3px rgba(45, 55, 72, 0.06);
    --shadow-sm: 0 2px 8px rgba(45, 55, 72, 0.08);
    --shadow-md: 0 4px 16px rgba(128, 90, 213, 0.12);
    --shadow-lg: 0 10px 30px rgba(128, 90, 213, 0.18);
    --shadow-xl: 0 20px 50px rgba(128, 90, 213, 0.28);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

  html, body {
    font-family: 'Baloo 2', 'Be Vietnam Pro', sans-serif;
    color: var(--ink);
    overflow: hidden;
    height: 100vh;
    width: 100vw;
    background:
      radial-gradient(circle at 10% 10%, #FFE4F1 0%, transparent 40%),
      radial-gradient(circle at 90% 20%, #E0E7FF 0%, transparent 40%),
      radial-gradient(circle at 50% 90%, #E6FFFA 0%, transparent 40%),
      linear-gradient(135deg, #FFF5F7 0%, #F7FAFC 100%);
  }

  /* === PAGE LAYOUT === */
  .page-wrap {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    position: relative;
  }

  .page-title {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    color: var(--lavender-deep);
    font-size: 13px;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(12px);
    padding: 6px 14px;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    z-index: 100;
    pointer-events: none;
    letter-spacing: 0.02em;
  }

  /* === PHONE FRAME === */
  .phone {
    width: min(380px, 100vw);
    height: min(820px, 100vh);
    background: var(--ink);
    border-radius: 48px;
    padding: 12px;
    box-shadow: var(--shadow-xl);
    position: relative;
    flex-shrink: 0;
  }
  .phone-screen {
    background: var(--cream);
    border-radius: 36px;
    overflow: hidden;
    height: 100%;
    width: 100%;
    position: relative;
  }
  .phone-notch {
    position: absolute;
    top: 16px; left: 50%;
    transform: translateX(-50%);
    width: 100px; height: 26px;
    background: var(--ink);
    border-radius: 999px;
    z-index: 200;
  }

  @media (max-width: 500px), (max-height: 700px) {
    .page-wrap { padding: 0; }
    .phone {
      width: 100vw; height: 100vh;
      border-radius: 0;
      padding: 0;
    }
    .phone-screen { border-radius: 0; }
    .phone-notch { display: none; }
    .page-title { display: none; }
  }

  /* === SCREEN TRANSITIONS (iOS-style) === */
  .screen {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 56px 22px 24px;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(100%, 0, 0);
    transition: transform 0.45s cubic-bezier(0.32, 0.72, 0.24, 1), opacity 0.35s ease;
    will-change: transform, opacity;
    overflow: hidden;
  }
  @media (max-width: 500px), (max-height: 700px) {
    .screen { padding: 60px 22px 32px; }
  }
  .screen.active {
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0);
  }
  .screen.exit-left {
    opacity: 0;
    transform: translate3d(-30%, 0, 0);
  }
  .screen.exit-right {
    opacity: 0;
    transform: translate3d(30%, 0, 0);
  }

  /* === COMMON HEADER === */
  .scr-header {
    display: flex;
    align-items: center;
    margin-bottom: 18px;
    gap: 14px;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }
  .scr-back {
    width: 38px; height: 38px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 10px rgba(128, 90, 213, 0.15);
    color: var(--ink-soft);
    border: 1px solid rgba(255, 255, 255, 0.6);
    cursor: pointer;
    font-size: 20px;
    font-weight: 700;
    flex-shrink: 0;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .scr-back:active {
    transform: scale(0.92);
    box-shadow: var(--shadow-xs);
  }
  .scr-title {
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    font-size: 21px;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  /* === DECORATIVE BACKGROUND === */
  .sky-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #FFE4F1 0%, #E9D8FD 50%, #BEE3F8 100%);
    z-index: -1;
  }
  .cloud {
    position: absolute;
    background: rgba(255,255,255,0.78);
    border-radius: 999px;
    pointer-events: none;
    animation: cloud-drift 30s linear infinite;
  }
  .cloud::before, .cloud::after {
    content: '';
    position: absolute;
    background: inherit;
    border-radius: 50%;
  }
  .cloud::before {
    width: 70%;
    height: 130%;
    top: -30%;
    left: 15%;
  }
  .cloud::after {
    width: 50%;
    height: 110%;
    top: -20%;
    right: 5%;
  }
  @keyframes cloud-drift {
    from { transform: translateX(0); }
    to { transform: translateX(20px); }
  }

  /* Menu cloud decorations - softer, behind content */
  .menu-clouds {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .menu-clouds .cloud {
    background: rgba(255, 255, 255, 0.55);
  }

  /* Soft sparkles decoration */
  .menu-sparkle {
    position: absolute;
    pointer-events: none;
    font-size: 14px;
    opacity: 0.6;
    animation: float-sparkle 4s ease-in-out infinite;
  }
  @keyframes float-sparkle {
    0%, 100% { transform: translateY(0) rotate(0); opacity: 0.4; }
    50% { transform: translateY(-6px) rotate(15deg); opacity: 0.7; }
  }

  /* ============================================================
     SPLASH / LOADING SCREEN
     ============================================================ */
  .scr-splash {
    background: linear-gradient(180deg, #FED7E2 0%, #E9D8FD 60%, #BEE3F8 100%);
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    z-index: 150;
    /* Splash starts ACTIVE - no entry transition */
    transform: translate3d(0, 0, 0);
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.5s ease;
  }
  .scr-splash.fade-out {
    opacity: 0;
    pointer-events: none;
  }
  .splash-clouds {
    position: absolute; inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .splash-clouds .cloud {
    background: rgba(255,255,255,0.6);
  }
  .splash-mascot {
    width: 140px;
    height: 140px;
    margin-bottom: 32px;
    animation: splash-mascot 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes splash-mascot {
    0% { transform: scale(0) rotate(-30deg); opacity: 0; }
    60% { transform: scale(1.15) rotate(5deg); opacity: 1; }
    100% { transform: scale(1) rotate(0); }
  }
  .splash-logo {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: 42px;
    line-height: 1;
    background: linear-gradient(135deg, var(--lavender-deep) 0%, var(--pink-deep) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
    text-align: center;
    animation: splash-fade 0.6s ease 0.3s both;
  }
  .splash-tagline {
    font-size: 14px;
    color: var(--ink-soft);
    margin-top: 6px;
    font-weight: 500;
    animation: splash-fade 0.6s ease 0.5s both;
  }
  @keyframes splash-fade {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .splash-loader {
    margin-top: 56px;
    width: 200px;
    height: 6px;
    background: rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    overflow: hidden;
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);
    animation: splash-fade 0.6s ease 0.7s both;
  }
  .splash-loader-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--lavender), var(--pink-deep));
    border-radius: 999px;
    animation: loader-fill 1.6s cubic-bezier(0.4, 0, 0.6, 1) 0.8s forwards;
    box-shadow: 0 0 12px rgba(237, 100, 166, 0.5);
  }
  @keyframes loader-fill {
    from { width: 0; }
    to { width: 100%; }
  }
  .splash-loading-text {
    font-family: 'Fredoka', sans-serif;
    font-size: 11px;
    color: var(--ink-mute);
    margin-top: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    animation: splash-fade 0.6s ease 0.9s both;
  }
  .splash-credits {
    position: absolute;
    bottom: 40px;
    font-size: 11px;
    color: var(--ink-mute);
    text-align: center;
    animation: splash-fade 0.6s ease 1.1s both;
  }
  .splash-credits strong {
    font-family: 'Fredoka', sans-serif;
    color: var(--lavender-deep);
  }

  /* ============================================================
     HOME SCREEN
     ============================================================ */
  .scr-home {
    padding-top: 50px;
    background: linear-gradient(180deg, #FFE4F1 0%, #E9D8FD 55%, #BEE3F8 100%);
  }
  .home-top-bar {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 8px;
    flex-shrink: 0;
  }
  .best-pill {
    background: var(--white);
    border-radius: 999px;
    padding: 6px 14px 6px 6px;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(183, 148, 246, 0.15);
  }
  .best-pill-icon {
    width: 26px; height: 26px;
    background: linear-gradient(135deg, #FFD700, #FFA500);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 6px rgba(255, 165, 0, 0.4);
  }
  .best-pill-icon svg { width: 14px; height: 14px; }
  .best-pill-text { display: flex; flex-direction: column; line-height: 1; }
  .best-pill .label {
    color: var(--ink-mute);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .best-pill .num {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    color: var(--ink);
    font-size: 15px;
    margin-top: 2px;
  }

  .home-logo {
    text-align: center;
    margin-top: 4px;
    flex-shrink: 0;
  }
  .home-logo h1 {
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
    background: linear-gradient(135deg, var(--lavender-deep) 0%, var(--pink-deep) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
    filter: drop-shadow(0 4px 12px rgba(128, 90, 213, 0.15));
  }
  .home-logo p {
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: 4px;
    font-weight: 500;
  }

  .home-mascot-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 0;
  }
  .home-mascot-stand {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .home-mascot {
    width: min(240px, 70%);
    max-height: 320px;
    animation: bounce-soft 3s ease-in-out infinite;
    filter: drop-shadow(0 12px 24px rgba(128, 90, 213, 0.2));
  }
  @keyframes bounce-soft {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-12px) rotate(1.5deg); }
  }
  .home-sparkle {
    position: absolute;
    font-size: 16px;
    pointer-events: none;
    animation: sparkle-pop 2.5s ease-in-out infinite;
  }
  .home-sparkle:nth-child(1) { top: 10%; left: 0; animation-delay: 0s; }
  .home-sparkle:nth-child(2) { top: 20%; right: 5%; animation-delay: 0.8s; font-size: 12px; }
  .home-sparkle:nth-child(3) { bottom: 30%; left: 10%; animation-delay: 1.5s; font-size: 14px; }
  @keyframes sparkle-pop {
    0%, 100% { opacity: 0; transform: scale(0) rotate(0); }
    50% { opacity: 1; transform: scale(1) rotate(180deg); }
  }

  .home-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
  }

  /* === BUTTONS === */
  .btn-cta {
    background: linear-gradient(135deg, var(--lavender-deep), var(--pink-deep));
    color: var(--white);
    border: none;
    border-radius: 999px;
    padding: 16px 28px;
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    font-size: 17px;
    cursor: pointer;
    box-shadow: 0 6px 0 rgba(105, 45, 175, 0.4), 0 12px 24px rgba(128, 90, 213, 0.3);
    transition: transform 0.12s, box-shadow 0.12s;
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    position: relative;
    overflow: hidden;
  }
  .btn-cta::before {
    content: '';
    position: absolute;
    top: 0; left: 6px; right: 6px; height: 40%;
    background: linear-gradient(180deg, rgba(255,255,255,0.25), transparent);
    border-radius: 999px;
    pointer-events: none;
  }
  .btn-cta:active {
    transform: translateY(4px);
    box-shadow: 0 2px 0 rgba(105, 45, 175, 0.4), 0 4px 12px rgba(128, 90, 213, 0.3);
  }

  .btn-secondary {
    background: var(--white);
    color: var(--lavender-deep);
    border: none;
    border-radius: 999px;
    padding: 12px 18px;
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    box-shadow: 0 4px 0 rgba(183, 148, 246, 0.25);
    transition: transform 0.12s, box-shadow 0.12s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .btn-secondary:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 rgba(183, 148, 246, 0.25);
  }
  .btn-row { display: flex; gap: 8px; }
  .btn-row .btn-secondary { flex: 1; padding: 11px 6px; font-size: 12px; }

  /* ============================================================
     RULES SCREEN
     ============================================================ */
  .scr-rules {
    background: linear-gradient(180deg, #FFE4F1 0%, #E9D8FD 55%, #BEE3F8 100%);
  }

  .rules-intro {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 18px;
    padding: 14px 16px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(128, 90, 213, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.6);
    position: relative;
    z-index: 1;
  }
  .rules-intro-icon {
    width: 42px; height: 42px;
    background: linear-gradient(135deg, #FBB6CE, #B794F6);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    box-shadow: 0 3px 8px rgba(183, 148, 246, 0.35);
    flex-shrink: 0;
    color: white;
  }
  .rules-intro-text {
    font-size: 12.5px;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .rules-intro-text strong {
    font-family: 'Fredoka', sans-serif;
    color: var(--lavender-deep);
  }

  .rules-list {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
    padding-right: 4px;
    position: relative;
    z-index: 1;
  }
  .rules-list::-webkit-scrollbar { width: 4px; }
  .rules-list::-webkit-scrollbar-thumb { background: var(--lavender-soft); border-radius: 4px; }

  .rule-card {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 18px;
    padding: 12px 14px;
    display: flex;
    gap: 12px;
    align-items: center;
    box-shadow: 0 4px 14px rgba(128, 90, 213, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.6);
    transition: transform 0.2s;
  }
  .rule-card:hover { transform: translateX(2px); }
  .rule-num {
    width: 32px; height: 32px;
    background: linear-gradient(135deg, var(--lavender), var(--pink));
    color: white;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(183, 148, 246, 0.4);
  }
  .rule-content { flex: 1; min-width: 0; }
  .rule-content h4 {
    font-family: 'Fredoka', sans-serif;
    font-size: 14px;
    color: var(--ink);
    margin-bottom: 2px;
    font-weight: 600;
  }
  .rule-content p {
    font-size: 11.5px;
    color: var(--ink-mute);
    line-height: 1.4;
  }
  .rule-illus {
    width: 56px; height: 48px;
    flex-shrink: 0;
  }

  /* ============================================================
     GAMEPLAY SCREEN
     ============================================================ */
  .scr-game {
    padding: 0;
    background: linear-gradient(180deg, #FFE4F1 0%, #E9D8FD 50%, #BEE3F8 100%);
  }
  #gameCanvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
  }
  .game-hud {
    position: absolute;
    top: 56px;
    left: 0; right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 18px;
    z-index: 5;
    pointer-events: none;
  }
  @media (max-width: 500px), (max-height: 700px) {
    .game-hud { top: 60px; }
  }
  .hud-stats-group {
    display: flex;
    gap: 6px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hud-pill {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-radius: 999px;
    padding: 8px 16px;
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 6px;
    box-shadow: var(--shadow-md);
    border: 1px solid rgba(255,255,255,0.5);
  }
  .hud-pill-sm {
    padding: 6px 11px;
    font-size: 13px;
    gap: 4px;
  }
  .hud-pill-sm svg { width: 13px; height: 13px; }
  .hud-pill svg { width: 16px; height: 16px; }
  .hud-best {
    background: linear-gradient(135deg, rgba(255, 224, 138, 0.95), rgba(246, 173, 85, 0.95));
    color: #744210;
  }
  .hud-best svg { color: #744210; }
  .hud-pause-btn {
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(12px);
    border: none;
    border-radius: 50%;
    width: 40px; height: 40px;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-soft);
    pointer-events: auto;
    border: 1px solid rgba(255,255,255,0.5);
    transition: transform 0.15s;
    flex-shrink: 0;
  }
  .hud-pause-btn:active { transform: scale(0.92); }

  /* === Countdown Overlay === */
  .countdown-overlay {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 20;
    pointer-events: none;
    background: rgba(45, 55, 72, 0.0);
    transition: background 0.3s;
  }
  .countdown-overlay.show {
    display: flex;
    background: rgba(45, 55, 72, 0.15);
    backdrop-filter: blur(2px);
  }
  .countdown-num {
