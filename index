<script>
// ============================================================
// STATE & STORAGE
// ============================================================
const STORAGE_KEY = 'lynkid_tower_bloxx';
let appState = {
  bestScore: 0,
  settings: {
    sound: true,
    music: true,
    vibration: true
  }
};

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      const parsed = JSON.parse(raw);
      appState = { ...appState, ...parsed, settings: { ...appState.settings, ...(parsed.settings || {}) } };
    }
  } catch (e) {}
}
function saveState() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
  } catch (e) {}
}

// ============================================================
// NAVIGATION — iOS-style slide transitions
// ============================================================
let currentScreen = 'home';
let transitioning = false;

function navigate(target, back = false) {
  if (currentScreen === target || transitioning) return;
  transitioning = true;

  if (currentScreen === 'game' && target !== 'result') {
    Game.state = 'idle';
  }

  const prev = document.querySelector(`.screen[data-screen="${currentScreen}"]`);
  const next = document.querySelector(`.screen[data-screen="${target}"]`);
  if (!next) { transitioning = false; return; }

  // Clear any leftover state from next
  next.classList.remove('active', 'exit-left', 'exit-right');

  if (back) {
    // Coming back: next slides in from LEFT
    next.style.transition = 'none';
    next.style.transform = 'translate3d(-100%, 0, 0)';
    next.style.opacity = '0';
    // Force reflow so the transform takes effect before transition resumes
    void next.offsetWidth;
    next.style.transition = '';
    next.style.transform = '';
    next.style.opacity = '';
    next.classList.add('active');

    if (prev) {
      prev.classList.remove('active');
      prev.classList.add('exit-right');
    }
  } else {
    // Forward: next slides in from RIGHT (its default position)
    next.classList.add('active');
    if (prev) {
      prev.classList.remove('active');
      prev.classList.add('exit-left');
    }
  }

  currentScreen = target;

  setTimeout(() => {
    if (prev) prev.classList.remove('exit-left', 'exit-right');
    transitioning = false;
  }, 480);

  // Screen-specific entry actions
  if (target === 'home') updateHomeBest();
  if (target === 'leaderboard') renderLeaderboard();
  if (target === 'settings') renderSettings();
}

// ============================================================
// SPLASH BOOT
// ============================================================
function bootApp() {
  // After loader animation completes, hide splash and show home
  setTimeout(() => {
    const splash = document.getElementById('splashScreen');
    splash.classList.add('fade-out');
    // Activate home screen without entry animation (it's our base screen)
    const home = document.querySelector('.screen[data-screen="home"]');
    home.style.transition = 'opacity 0.5s ease';
    home.style.transform = 'translate3d(0,0,0)';
    home.classList.add('active');
    setTimeout(() => {
      splash.remove();
      home.style.transition = '';
    }, 500);
  }, 2500);
}

