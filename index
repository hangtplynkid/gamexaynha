// ============================================================
// GAME
// ============================================================
// Single block design - one color across all blocks (lavender brand)
const BLOCK_PALETTE = { color: '#B794F6', light: '#D6BCFA', dark: '#805AD5' };

// Square block dimensions
const BLOCK_W = 72;
const BLOCK_H = 72;

// Drop timer: 5 seconds per drop
const DROP_TIMER_MS = 5000;

// Anti-spam: cooldown between consecutive drops
const DROP_COOLDOWN_MS = 700; // total delay before next block becomes droppable
const NEW_BLOCK_INPUT_LOCK_MS = 300; // additional input lock right after new block spawns

// Pendulum config: block swings like a pendulum from fixed crane point
const PENDULUM_AMPLITUDE = 0.45; // ~25 degrees in radians
const PENDULUM_PERIOD_MS = 1600; // full swing cycle
const CRANE_PIVOT_Y = 70; // fixed Y position of crane hook (in screen space)
const CABLE_LENGTH = 70; // length from crane pivot to block top

const Game = {
  state: 'idle', // 'idle' | 'countdown' | 'playing' | 'paused' | 'ended'
  countdownStep: 0, // 0..3 (3,2,1,Go)
  countdownStart: 0,
  canvas: null,
  ctx: null,
  W: 0, H: 0, dpr: 1,
  blocks: [],
  crane: { x: 0 }, // fixed at W/2, no longer moves
  pendulumPhase: 0, // current phase angle for swing
  pendulumSpeed: 1.0, // multiplier for swing speed (increases with tower height)
  falling: null,
  cameraY: 0,
  targetCameraY: 0,
  floors: 0,
  residents: 0,
  particles: [],
  flyingResidents: [],
  timerStart: 0,
  timerRemaining: DROP_TIMER_MS,
  inputLockUntil: 0, // performance.now() timestamp until which taps are ignored
  lastDropTime: 0, // timestamp of last drop, for spam prevention
  lastTime: 0,
  shake: 0,
  missAnimating: false
};

function initCanvas() {
  Game.canvas = document.getElementById('gameCanvas');
  Game.ctx = Game.canvas.getContext('2d');
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  Game.canvas.addEventListener('click', handleTap);
  Game.canvas.addEventListener('touchstart', (e) => {
    e.preventDefault();
    handleTap(e);
  }, { passive: false });
}

function resizeCanvas() {
  if (!Game.canvas) return;
  Game.dpr = window.devicePixelRatio || 1;
  const rect = Game.canvas.getBoundingClientRect();
  Game.W = rect.width;
  Game.H = rect.height;
  Game.canvas.width = Game.W * Game.dpr;
  Game.canvas.height = Game.H * Game.dpr;
  Game.ctx.setTransform(Game.dpr, 0, 0, Game.dpr, 0, 0);
}

function startGame() {
  setTimeout(() => {
    resizeCanvas();
    resetGame();
    // Start in countdown state instead of playing immediately
    Game.state = 'countdown';
    Game.countdownStep = -1; // will be set to 0 on first updateCountdown tick
    Game.countdownStart = performance.now();
    Game.timerStart = 0; // timer won't start until countdown done
    const hint = document.getElementById('tapHint');
    if (hint) {
      hint.style.display = 'flex';
      setTimeout(() => { if (hint) hint.style.display = 'none'; }, 4500);
    }
  }, 50);
}

function resetGame() {
  Game.blocks = [];
  Game.falling = null;
  Game.cameraY = 0;
  Game.targetCameraY = 0;
  Game.floors = 0;
  Game.residents = 0;
  Game.particles = [];
  Game.flyingResidents = [];
  Game.shake = 0;
  Game.missAnimating = false;
  Game.timerStart = 0;
  Game.timerRemaining = DROP_TIMER_MS;
  Game.inputLockUntil = 0;
  Game.lastDropTime = 0;
  Game.crane.x = Game.W / 2;
  Game.pendulumPhase = 0;
  Game.pendulumSpeed = 1.0;
  // NOTE: no base auto-spawn — player drops base as the first block
  spawnNext();
  updateHUD();
}

function spawnNext() {
  // Crane is fixed at center; pendulum speed scales with tower height
  Game.crane.x = Game.W / 2;
  Game.pendulumSpeed = Math.min(1.0 + Game.blocks.length * 0.04, 2.0);
  // Lock input briefly so player can't tap-spam through blocks
  Game.inputLockUntil = performance.now() + NEW_BLOCK_INPUT_LOCK_MS;
  // Start drop timer only if already playing (otherwise wait for countdown)
  // Timer starts AFTER input lock window so player gets full 5s of actual drop time
  if (Game.state === 'playing') {
    Game.timerStart = performance.now() + NEW_BLOCK_INPUT_LOCK_MS;
    Game.timerRemaining = DROP_TIMER_MS;
  } else {
    Game.timerStart = 0;
  }
}

// Compute current pendulum X offset based on phase angle
function getPendulumX() {
  // Angle oscillates as sin wave; pendulum X = pivot + sin(phase) * cable_length * sin(amplitude)
  const angle = Math.sin(Game.pendulumPhase) * PENDULUM_AMPLITUDE;
  return Math.sin(angle) * CABLE_LENGTH;
}

function handleTap(e) {
  if (Game.state !== 'playing') return;
  if (Game.falling) return;
  // Anti-spam: ignore taps during input lock window
  if (performance.now() < Game.inputLockUntil) return;
  // Anti-spam: must wait minimum cooldown since last drop
  if (performance.now() - Game.lastDropTime < DROP_COOLDOWN_MS) return;
  if (e) e.preventDefault();
  dropBlock();
  if (appState.settings.sound) playSound('tap');
}

function dropBlock() {
  // Block drops from its current pendulum position
  const offsetX = getPendulumX();
  Game.falling = {
    x: Game.crane.x + offsetX - BLOCK_W / 2,
    y: CRANE_PIVOT_Y + CABLE_LENGTH,
    w: BLOCK_W,
    h: BLOCK_H,
    vy: 0,
    palette: BLOCK_PALETTE,
    windowPattern: 0,
    litCount: 0,
    isBase: Game.blocks.length === 0 // first block is base
  };
  Game.lastDropTime = performance.now();
  const hint = document.getElementById('tapHint');
  if (hint) hint.style.display = 'none';
}

function landBlock() {
  const fb = Game.falling;

  // Special case: first block (base) - lands on the ground, no overlap check
  if (Game.blocks.length === 0) {
    const baseBlock = {
      x: fb.x,
      y: Game.H - 100 - BLOCK_H + BLOCK_H, // ground level (top of block)
      w: BLOCK_W,
      h: BLOCK_H,
      color: '#FFFAF0',
      light: '#FFFFFF',
      dark: '#D69E2E',
      base: true,
      windowPattern: 0,
      litCount: 0
    };
    // Adjust y: place block so its bottom rests on ground
    baseBlock.y = Game.H - 30 - BLOCK_H;
    Game.blocks.push(baseBlock);
    Game.falling = null;
    Game.floors++;
    spawnParticles(fb.x + fb.w / 2, fb.y + 18, fb.palette.color, 'land');
    if (appState.settings.sound) playSound('land');
    vibrate(12);
    updateHUD();
    setTimeout(spawnNext, 500);
    return;
  }

  const top = Game.blocks[Game.blocks.length - 1];
  const left = Math.max(fb.x, top.x);
  const right = Math.min(fb.x + fb.w, top.x + top.w);
  const overlap = right - left;

  // Total miss → game over
  if (overlap <= 0) {
    spawnParticles(fb.x + fb.w / 2, fb.y, fb.palette.color, 'crash');
    Game.shake = 10;
    if (appState.settings.sound) playSound('crash');
    vibrate(60);

    // Animate the missed block falling down off-screen
    Game.missAnimating = true;
    Game.falling = null;
    setTimeout(gameOver, 700);
    return;
  }

  const offset = (fb.x + fb.w / 2) - (top.x + top.w / 2);
  const isPerfect = Math.abs(offset) < 6;

  let landX = fb.x;
  if (isPerfect) {
    // Snap to perfect alignment
    landX = top.x;
    showCombo('PERFECT!');
    spawnParticles(top.x + top.w / 2, fb.y, fb.palette.color, 'perfect');
    if (appState.settings.sound) playSound('perfect');
    vibrate([15, 25, 15]);
  } else {
    // Land at player's position - block keeps full size
    spawnParticles(landX + fb.w / 2, fb.y + 18, fb.palette.color, 'land');
    if (appState.settings.sound) playSound('land');
    vibrate(12);
  }

  // Add block with FULL original width (no chipping), track perfect status
  const newBlock = {
    x: landX,
    y: top.y - BLOCK_H,
    w: fb.w,
    h: BLOCK_H,
    color: fb.palette.color,
    light: fb.palette.light,
    dark: fb.palette.dark,
    base: false,
    windowPattern: 0, // start dark
    litCount: 0,
    isPerfect: isPerfect
  };
  Game.blocks.push(newBlock);

  Game.falling = null;
  Game.floors++;

  // If perfect, spawn a resident flying into this block
  if (isPerfect) {
    spawnResident(newBlock);
  }

  updateHUD();

  // Camera scroll - blocks are taller now
  const newTopY = top.y - BLOCK_H;
  if (newTopY < 200 - Game.cameraY) {
    Game.targetCameraY = (200 - newTopY);
  }

  setTimeout(spawnNext, 500);
}

// Spawn a flying resident that arrives at the given block
function spawnResident(block) {
  // Spawn from a random side, off-screen
  const fromLeft = Math.random() > 0.5;
  const startX = fromLeft ? -30 : Game.W + 30;
  // Spawn at a Y above the block (in screen space, after applying camera)
  const targetScreenY = block.y + Game.cameraY + BLOCK_H / 2;
  const startY = Math.max(40, targetScreenY - 100);
  Game.flyingResidents.push({
    x: startX,
    y: startY,
    targetBlock: block,
    progress: 0, // 0 → 1 along curved path
    duration: 1200, // ms
    elapsed: 0,
    startX, startY,
    controlOffsetY: -50 - Math.random() * 30 // arc height
  });
}

function spawnParticles(x, y, color, type) {
  let count, speed, life;
  switch (type) {
    case 'perfect': count = 22; speed = 4.8; life = 60; break;
    case 'crash': count = 16; speed = 5.5; life = 50; break;
    default: count = 10; speed = 2.8; life = 32;
  }
  for (let i = 0; i < count; i++) {
    const angle = (Math.PI * 2 * i / count) + (Math.random() - 0.5) * 0.5;
    const v = speed * (0.5 + Math.random() * 0.5);
    Game.particles.push({
      x, y,
      vx: Math.cos(angle) * v,
      vy: Math.sin(angle) * v - (type === 'perfect' ? 1.5 : 0.3),
      life,
      maxLife: life,
      color,
      size: 2.5 + Math.random() * 3.5,
      type,
      rot: Math.random() * Math.PI * 2,
      rotSpeed: (Math.random() - 0.5) * 0.3
    });
  }
}

function showCombo(text) {
  const popup = document.getElementById('comboPopup');
  popup.textContent = text;
  popup.classList.remove('show');
  void popup.offsetWidth;
  popup.classList.add('show');
}

function updateHUD() {
  document.getElementById('floorCounter').textContent = Game.floors;
  const residentEl = document.getElementById('residentCounter');
  if (residentEl) residentEl.textContent = Game.residents;
  // Live best display - show max of stored best vs current
  const bestF = document.getElementById('liveBestFloors');
  const bestR = document.getElementById('liveBestResidents');
  if (bestF && bestR) {
    const bestFloors = Math.max((appState.bestRecords && appState.bestRecords.floors) || 0, Game.floors);
    const bestResidents = Math.max((appState.bestRecords && appState.bestRecords.residents) || 0, Game.residents);
    bestF.textContent = bestFloors;
    bestR.textContent = bestResidents;
  }
}

// Note: no combined score formula - leaderboard tracks 2 separate metrics

function gameOver() {
  if (Game.state === 'ended') return;
  Game.state = 'ended';
  if (appState.settings.sound) playSound('gameover');

  const finalFloors = Game.floors;
  const finalResidents = Game.residents;

  // Track best records (2 separate records, no combined score)
  if (!appState.bestRecords) {
    appState.bestRecords = { floors: 0, residents: 0 };
  }
  const isNewFloorsRecord = finalFloors > (appState.bestRecords.floors || 0);
  const isNewResidentsRecord = finalResidents > (appState.bestRecords.residents || 0);

  if (isNewFloorsRecord) appState.bestRecords.floors = finalFloors;
  if (isNewResidentsRecord) appState.bestRecords.residents = finalResidents;
  saveState();

  const isNewRecord = isNewFloorsRecord || isNewResidentsRecord;

  // Populate result screen - 2 stats only, no combined score
  document.getElementById('resultFloors').textContent = finalFloors;
  document.getElementById('resultResidents').textContent = finalResidents;
  document.getElementById('resultBestFloors').textContent = appState.bestRecords.floors || 0;
  document.getElementById('resultBestResidents').textContent = appState.bestRecords.residents || 0;
  document.getElementById('resultRecord').style.display = (isNewRecord && (finalFloors > 0 || finalResidents > 0)) ? 'inline-flex' : 'none';

  // Show confetti only for new record
  const confetti = document.getElementById('resultConfetti');
  if (confetti) {
    confetti.style.display = (isNewRecord && (finalFloors > 0 || finalResidents > 0)) ? 'block' : 'none';
  }

  const titleEl = document.getElementById('resultTitle');
  const subEl = document.getElementById('resultSub');
  const sparklesEl = document.getElementById('trophySparkles');

  if (isNewRecord && (finalFloors > 0 || finalResidents > 0)) {
    titleEl.textContent = 'Chúc mừng!';
    if (isNewFloorsRecord && isNewResidentsRecord) {
      subEl.textContent = 'Bạn vừa phá kỷ lục cả 2 chỉ số ✨';
    } else if (isNewFloorsRecord) {
      subEl.textContent = 'Bạn vừa phá kỷ lục số tầng 🏗';
    } else {
      subEl.textContent = 'Bạn vừa phá kỷ lục số cư dân 👥';
    }
    if (sparklesEl) sparklesEl.style.display = '';
  } else if (finalFloors >= 10) {
    titleEl.textContent = 'Khá ổn!';
    subEl.textContent = 'Một tòa tháp đáng tự hào nha 🏗';
    if (sparklesEl) sparklesEl.style.display = '';
  } else {
    titleEl.textContent = 'Cố lên nha!';
    subEl.textContent = 'Lần sau chắc cao hơn 🌱';
    if (sparklesEl) sparklesEl.style.display = 'none';
  }

  setTimeout(() => navigate('result'), 500);
}

function pauseGame() {
  if (Game.state !== 'playing') return;
  // Save remaining time before pausing
  if (Game.timerStart > 0) {
    const elapsed = performance.now() - Game.timerStart;
    Game.timerRemaining = Math.max(0, DROP_TIMER_MS - elapsed);
  }
  Game.state = 'paused';
  document.getElementById('pauseOverlay').classList.add('show');
  if (appState.settings.sound) playSound('tap');
}

function resumeGame() {
  if (Game.state !== 'paused') return;
  Game.state = 'playing';
  // Resume timer from where we paused
  Game.timerStart = performance.now() - (DROP_TIMER_MS - Game.timerRemaining);
  document.getElementById('pauseOverlay').classList.remove('show');
  if (appState.settings.sound) playSound('tap');
}

function confirmQuitGame() {
  // Show exit confirm overlay on top of pause overlay
  document.getElementById('pauseOverlay').classList.remove('show');
  document.getElementById('exitConfirmOverlay').classList.add('show');
  if (appState.settings.sound) playSound('tap');
}

function cancelQuitGame() {
  // Hide exit confirm, go back to pause overlay
  document.getElementById('exitConfirmOverlay').classList.remove('show');
  document.getElementById('pauseOverlay').classList.add('show');
  if (appState.settings.sound) playSound('tap');
}

function quitGame() {
  Game.state = 'idle';
  document.getElementById('pauseOverlay').classList.remove('show');
  document.getElementById('exitConfirmOverlay').classList.remove('show');
  navigate('home', true);
}

// Update countdown overlay display each frame
function updateCountdown() {
  const overlay = document.getElementById('countdownOverlay');
  const numEl = document.getElementById('countdownNum');
  if (!overlay || !numEl) return;

  if (Game.state !== 'countdown') {
    overlay.classList.remove('show');
    return;
  }

  overlay.classList.add('show');
  const elapsed = performance.now() - Game.countdownStart;
  // 4 steps: "3", "2", "1", "Bắt đầu!" - each 800ms
  const step = Math.floor(elapsed / 800);

  if (step !== Game.countdownStep) {
    Game.countdownStep = step;
    // Trigger pop animation
    numEl.classList.remove('pop');
    void numEl.offsetWidth;
    numEl.classList.add('pop');
    if (appState.settings.sound) playSound('tap');
  }

  if (step === 0) {
    numEl.textContent = '3';
    numEl.className = 'countdown-num pop num-large';
  } else if (step === 1) {
    numEl.textContent = '2';
    numEl.className = 'countdown-num pop num-large';
  } else if (step === 2) {
    numEl.textContent = '1';
    numEl.className = 'countdown-num pop num-large';
  } else if (step === 3) {
    numEl.textContent = 'Bắt đầu!';
    numEl.className = 'countdown-num pop num-go';
  } else {
    // Done - transition to playing
    Game.state = 'playing';
    overlay.classList.remove('show');
    Game.timerStart = performance.now();
    Game.timerRemaining = DROP_TIMER_MS;
  }
}

// ============================================================
// RENDER LOOP
// ============================================================
function render(t) {
  if (!Game.lastTime) Game.lastTime = t;
  const dt = Math.min((t - Game.lastTime) / 16.67, 2);
  Game.lastTime = t;

  if (Game.canvas && (Game.state === 'playing' || Game.state === 'paused' || Game.state === 'ended' || Game.state === 'idle' || Game.state === 'countdown')) {
    drawScene(dt);
  }
  updateCountdown();
  requestAnimationFrame(render);
}

function drawScene(dt) {
  const { ctx, W, H } = Game;

  // smooth camera
  Game.cameraY += (Game.targetCameraY - Game.cameraY) * 0.08;

  // shake
  let shakeX = 0, shakeY = 0;
  if (Game.shake > 0) {
    shakeX = (Math.random() - 0.5) * Game.shake;
    shakeY = (Math.random() - 0.5) * Game.shake;
    Game.shake *= 0.85;
    if (Game.shake < 0.5) Game.shake = 0;
  }
  ctx.save();
  ctx.translate(shakeX, shakeY);

  // sky background
  const grad = ctx.createLinearGradient(0, 0, 0, H);
  grad.addColorStop(0, '#FFE4F1');
  grad.addColorStop(0.5, '#E9D8FD');
  grad.addColorStop(1, '#BEE3F8');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  // clouds
  drawCloud(W * 0.15, 90 + Game.cameraY * 0.1, 28);
  drawCloud(W * 0.78, 140 + Game.cameraY * 0.15, 22);
  drawCloud(W * 0.45, 240 + Game.cameraY * 0.1, 26);
  drawCloud(W * 0.25, 340 + Game.cameraY * 0.2, 20);

  // distant city silhouette
  ctx.fillStyle = 'rgba(183, 148, 246, 0.22)';
  const cityY = H - 130 + Game.cameraY * 0.3;
  drawCitySilhouette(ctx, cityY, W);

  // ground
  ctx.fillStyle = '#9AE6B4';
  ctx.fillRect(0, H - 42 + Game.cameraY, W, 100);
  ctx.fillStyle = '#68D391';
  ctx.fillRect(0, H - 42 + Game.cameraY, W, 5);
  // tiny grass tufts
  for (let i = 0; i < 6; i++) {
    const gx = (i * 60 + 20) % W;
    ctx.fillStyle = '#68D391';
    ctx.beginPath();
    ctx.moveTo(gx, H - 38 + Game.cameraY);
    ctx.lineTo(gx + 2, H - 44 + Game.cameraY);
    ctx.lineTo(gx + 4, H - 38 + Game.cameraY);
    ctx.fill();
  }

  // tower blocks
  for (let i = 0; i < Game.blocks.length; i++) {
    const b = Game.blocks[i];
    const drawY = b.y + Game.cameraY;
    if (drawY < -50 || drawY > H + 50) continue;
    drawBlock(ctx, b, drawY);
  }

  // roof on tallest block
  if (Game.blocks.length > 1) {
    const top = Game.blocks[Game.blocks.length - 1];
    const drawY = top.y + Game.cameraY;
    if (drawY > -30 && drawY < H + 30) {
      drawRoof(ctx, top, drawY);
    }
  }

  if (Game.state === 'playing' && !Game.falling && !Game.missAnimating) {
    // Pendulum phase advances
    Game.pendulumPhase += (Math.PI * 2 / (PENDULUM_PERIOD_MS / 16.67)) * Game.pendulumSpeed * dt;

    // Check drop timer - auto drop if user takes too long
    if (Game.timerStart > 0) {
      const elapsed = performance.now() - Game.timerStart;
      if (elapsed >= DROP_TIMER_MS) {
        // Force drop at current pendulum position
        dropBlock();
        if (appState.settings.sound) playSound('tap');
      }
    }
  }

  // crane bar (always visible during game and countdown)
  if (Game.state === 'playing' || Game.state === 'paused' || Game.state === 'countdown') {
    drawCrane(ctx, W);
  }

  // cable + hanging block (pendulum)
  if ((Game.state === 'playing' || Game.state === 'countdown') && !Game.falling && !Game.missAnimating) {
    const pivotX = Game.crane.x;
    const pivotY = CRANE_PIVOT_Y;
    const angle = Math.sin(Game.pendulumPhase) * PENDULUM_AMPLITUDE;
    const blockCenterX = pivotX + Math.sin(angle) * CABLE_LENGTH;
    const blockTopY = pivotY + Math.cos(angle) * CABLE_LENGTH;

    // Cable from pivot to top of block
    ctx.strokeStyle = '#4A5568';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(pivotX, pivotY);
    ctx.lineTo(blockCenterX, blockTopY);
    ctx.stroke();

    // Hook at bottom of cable
    ctx.fillStyle = '#4A5568';
    ctx.beginPath();
    ctx.arc(blockCenterX, blockTopY, 4, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#2D3748';
    ctx.beginPath();
    ctx.arc(blockCenterX, blockTopY, 1.5, 0, Math.PI * 2);
    ctx.fill();

    // Hanging block - first block is base style, otherwise lavender
    const isBase = Game.blocks.length === 0;
    const blockX = blockCenterX - BLOCK_W / 2;
    const blockY = blockTopY + 4;
    const hangBlock = {
      x: blockX,
      w: BLOCK_W,
      h: BLOCK_H,
      color: isBase ? '#FFFAF0' : BLOCK_PALETTE.color,
      light: isBase ? '#FFFFFF' : BLOCK_PALETTE.light,
      dark: isBase ? '#D69E2E' : BLOCK_PALETTE.dark,
      base: isBase,
      windowPattern: 0,
      litCount: 0
    };
    drawBlock(ctx, hangBlock, blockY);

    // Timer ring around hanging block (only when playing, after input lock window)
    if (Game.state === 'playing' && Game.timerStart > 0 && performance.now() >= Game.timerStart) {
      drawTimerRing(ctx, blockX, blockY, BLOCK_W, BLOCK_H);
    }
  }

  // falling block
  if (Game.falling) {
    Game.falling.vy += 1.4 * dt;
    Game.falling.y += Game.falling.vy * dt;
    // Target Y: top of last block, or ground level if no blocks yet
    let targetY;
    if (Game.blocks.length === 0) {
      // No tower yet - land on ground
      targetY = H - 30 - BLOCK_H + Game.cameraY;
    } else {
      const top = Game.blocks[Game.blocks.length - 1];
      targetY = top.y + Game.cameraY - BLOCK_H;
    }
    if (Game.falling.y >= targetY) {
      Game.falling.y = targetY;
      landBlock();
    } else {
      drawBlock(ctx, {
        x: Game.falling.x,
        w: Game.falling.w,
        h: Game.falling.h,
        color: Game.falling.palette.color,
        light: Game.falling.palette.light,
        dark: Game.falling.palette.dark,
        base: Game.falling.isBase || false,
        windowPattern: Game.falling.windowPattern
      }, Game.falling.y);
    }
  }

  // particles
  for (let i = Game.particles.length - 1; i >= 0; i--) {
    const p = Game.particles[i];
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.vy += 0.2 * dt;
    p.life -= dt;
    p.rot += p.rotSpeed * dt;
    if (p.life <= 0) {
      Game.particles.splice(i, 1);
      continue;
    }
    const alpha = Math.max(0, p.life / p.maxLife);
    ctx.globalAlpha = alpha;
    if (p.type === 'perfect') {
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = 'rgba(255,255,255,0.85)';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size + 1.5, 0, Math.PI * 2);
      ctx.stroke();
    } else {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.size/2, -p.size/2, p.size, p.size);
      ctx.restore();
    }
    ctx.globalAlpha = 1;
  }

  // Flying residents
  for (let i = Game.flyingResidents.length - 1; i >= 0; i--) {
    const r = Game.flyingResidents[i];
    r.elapsed += dt * 16.67;
    r.progress = Math.min(1, r.elapsed / r.duration);

    // Target position in screen space (updates with camera)
    const targetX = r.targetBlock.x + r.targetBlock.w / 2;
    const targetY = r.targetBlock.y + Game.cameraY + r.targetBlock.h / 2;

    // Bezier curve: start → control (high arc) → target
    const t = r.progress;
    const controlX = (r.startX + targetX) / 2;
    const controlY = Math.min(r.startY, targetY) + r.controlOffsetY;
    const omt = 1 - t;
    const cx = omt * omt * r.startX + 2 * omt * t * controlX + t * t * targetX;
    const cy = omt * omt * r.startY + 2 * omt * t * controlY + t * t * targetY;
    r.x = cx;
    r.y = cy;

    // Draw resident - tiny figure with parachute look
    drawResident(ctx, r.x, r.y, r.targetBlock.x < cx);

    // Arrived → light up a window in the block, remove resident
    if (r.progress >= 1) {
      // Increment lit windows on this block (cap at 9)
      if (r.targetBlock.litCount < 9) {
        const availableBits = [];
        for (let bit = 0; bit < 9; bit++) {
          if (!((r.targetBlock.windowPattern >> bit) & 1)) availableBits.push(bit);
        }
        if (availableBits.length > 0) {
          const pickBit = availableBits[Math.floor(Math.random() * availableBits.length)];
          r.targetBlock.windowPattern |= (1 << pickBit);
          r.targetBlock.litCount++;
        }
      }
      Game.residents++;
      updateHUD();
      // Small spark at arrival
      spawnParticles(targetX, targetY, '#FFE08A', 'land');
      if (appState.settings.sound) playSound('land');
      Game.flyingResidents.splice(i, 1);
    }
  }

  ctx.restore();
}

// Draw a tiny resident figure (parachuting style)
function drawResident(ctx, x, y, faceRight) {
  ctx.save();
  ctx.translate(x, y);
  // Parachute canopy
  ctx.fillStyle = '#FBB6CE';
  ctx.beginPath();
  ctx.arc(0, -10, 9, Math.PI, 2 * Math.PI);
  ctx.fill();
  // Parachute shadow
  ctx.fillStyle = 'rgba(45, 55, 72, 0.15)';
  ctx.beginPath();
  ctx.arc(0, -10, 9, Math.PI * 0.95, Math.PI * 1.4);
  ctx.fill();
  // Strings
  ctx.strokeStyle = '#4A5568';
  ctx.lineWidth = 0.7;
  ctx.beginPath();
  ctx.moveTo(-7, -8); ctx.lineTo(-2, 0);
  ctx.moveTo(7, -8); ctx.lineTo(2, 0);
  ctx.stroke();
  // Body
  ctx.fillStyle = '#805AD5';
  ctx.beginPath();
  ctx.ellipse(0, 3, 3.5, 4.5, 0, 0, Math.PI * 2);
  ctx.fill();
  // Head
  ctx.fillStyle = '#FFE8D6';
  ctx.beginPath();
  ctx.arc(0, -1, 2.5, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
}

// ============================================================
// DRAW HELPERS
// ============================================================
function drawBlock(ctx, b, drawY) {
  const r = 8;

  // === LAYER 1: Soft drop shadow on ground (only barely visible) ===
  ctx.fillStyle = 'rgba(45, 55, 72, 0.10)';
  roundRect(ctx, b.x + 4, drawY + b.h - 2, b.w - 8, 8, 4);
  ctx.fill();

  // === LAYER 2: Side / depth (back face peeking through) ===
  ctx.fillStyle = b.dark;
  roundRect(ctx, b.x, drawY + 5, b.w, b.h, r);
  ctx.fill();

  // === LAYER 3: Main body with subtle gradient ===
  const grad = ctx.createLinearGradient(0, drawY, 0, drawY + b.h);
  grad.addColorStop(0, b.light);
  grad.addColorStop(0.35, b.color);
  grad.addColorStop(1, b.color);
  ctx.fillStyle = grad;
  roundRect(ctx, b.x, drawY, b.w, b.h, r);
  ctx.fill();

  // === LAYER 4: Inner shadow on right side for depth ===
  ctx.save();
  roundRect(ctx, b.x, drawY, b.w, b.h, r);
  ctx.clip();
  const sideGrad = ctx.createLinearGradient(b.x + b.w - 14, 0, b.x + b.w, 0);
  sideGrad.addColorStop(0, 'rgba(0,0,0,0)');
  sideGrad.addColorStop(1, 'rgba(45, 55, 72, 0.18)');
  ctx.fillStyle = sideGrad;
  ctx.fillRect(b.x + b.w - 14, drawY, 14, b.h);
  ctx.restore();

  // === LAYER 5: Top highlight (specular) ===
  ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
  roundRect(ctx, b.x + 6, drawY + 3, b.w - 12, 3, 1.5);
  ctx.fill();

  // === LAYER 6: Horizontal mid-band (architectural detail) ===
  if (!b.base) {
    ctx.fillStyle = 'rgba(255, 255, 255, 0.18)';
    ctx.fillRect(b.x + 2, drawY + b.h / 2 - 0.5, b.w - 4, 1);
    ctx.fillStyle = 'rgba(45, 55, 72, 0.10)';
    ctx.fillRect(b.x + 2, drawY + b.h / 2 + 0.5, b.w - 4, 0.5);
  }

  // === LAYER 7: Windows or door ===
  if (b.base) {
    drawBaseDoor(ctx, b, drawY);
  } else {
    drawWindows(ctx, b, drawY);
  }

  // === LAYER 8: Bottom inner shadow line ===
  ctx.fillStyle = 'rgba(45, 55, 72, 0.12)';
  ctx.fillRect(b.x + 4, drawY + b.h - 2, b.w - 8, 1);

  // === LAYER 9: Outline (very subtle) ===
  ctx.strokeStyle = 'rgba(45, 55, 72, 0.08)';
  ctx.lineWidth = 1;
  roundRect(ctx, b.x + 0.5, drawY + 0.5, b.w - 1, b.h - 1, r);
  ctx.stroke();
}

function drawWindows(ctx, b, drawY) {
  if (b.w < 40) return;

  // 3x3 window grid for square block
  const winW = 12;
  const winH = 13;
  const gap = 4;
  const cols = 3;
  const rows = 3;
  const totalW = cols * winW + (cols - 1) * gap;
  const totalH = rows * winH + (rows - 1) * gap;
  const startX = b.x + (b.w - totalW) / 2;
  const startY = drawY + (b.h - totalH) / 2 + 1;

  for (let row = 0; row < rows; row++) {
    for (let c = 0; c < cols; c++) {
      const wx = startX + c * (winW + gap);
      const wy = startY + row * (winH + gap);
      const bit = row * cols + c;
      const isLit = (b.windowPattern >> (bit % 9)) & 1;

      // === Window frame (recessed look) ===
      ctx.fillStyle = 'rgba(45, 55, 72, 0.45)';
      roundRect(ctx, wx - 1, wy - 1, winW + 2, winH + 2, 2);
      ctx.fill();

      // === Glass ===
      if (isLit) {
        // Warm yellow lit window with gradient
        const lit = ctx.createLinearGradient(wx, wy, wx, wy + winH);
        lit.addColorStop(0, '#FFE08A');
        lit.addColorStop(0.5, '#F6AD55');
        lit.addColorStop(1, '#ED8936');
        ctx.fillStyle = lit;
        roundRect(ctx, wx, wy, winW, winH, 1.5);
        ctx.fill();
        // Subtle glow
        ctx.fillStyle = 'rgba(255, 224, 138, 0.3)';
        roundRect(ctx, wx - 2, wy - 2, winW + 4, winH + 4, 3);
        ctx.fill();
        // Re-draw window over glow
        ctx.fillStyle = lit;
        roundRect(ctx, wx, wy, winW, winH, 1.5);
        ctx.fill();
      } else {
        // Unlit cool blue glass with reflection
        const unlit = ctx.createLinearGradient(wx, wy, wx + winW, wy + winH);
        unlit.addColorStop(0, '#90CDF4');
        unlit.addColorStop(0.4, '#63B3ED');
        unlit.addColorStop(1, '#4299E1');
        ctx.fillStyle = unlit;
        roundRect(ctx, wx, wy, winW, winH, 1.5);
        ctx.fill();
        // Diagonal glass reflection
        ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
        ctx.beginPath();
        ctx.moveTo(wx + 1, wy + 1);
        ctx.lineTo(wx + winW * 0.5, wy + 1);
        ctx.lineTo(wx + 1, wy + winH * 0.5);
        ctx.closePath();
        ctx.fill();
      }

      // === Window cross divider ===
      ctx.fillStyle = 'rgba(45, 55, 72, 0.4)';
      ctx.fillRect(wx + winW / 2 - 0.5, wy + 1, 1, winH - 2);
      ctx.fillRect(wx + 1, wy + winH / 2 - 0.5, winW - 2, 1);

      // === Window sill bottom ===
      ctx.fillStyle = 'rgba(45, 55, 72, 0.25)';
      ctx.fillRect(wx - 1, wy + winH, winW + 2, 1);
    }
  }
}

function drawBaseDoor(ctx, b, drawY) {
  // === LYNKID Sign at top ===
  const signW = 44;
  const signH = 14;
  const signX = b.x + b.w / 2 - signW / 2;
  const signY = drawY + 9;

  // Sign backdrop with gradient
  const signGrad = ctx.createLinearGradient(0, signY, 0, signY + signH);
  signGrad.addColorStop(0, '#3D2671');
  signGrad.addColorStop(1, '#553C9A');
  ctx.fillStyle = signGrad;
  roundRect(ctx, signX, signY, signW, signH, 3);
  ctx.fill();
  // Sign border highlight
  ctx.strokeStyle = 'rgba(255,255,255,0.25)';
  ctx.lineWidth = 0.8;
  roundRect(ctx, signX + 0.5, signY + 0.5, signW - 1, signH - 1, 2.5);
  ctx.stroke();
  // Sign text
  ctx.fillStyle = '#FFE08A';
  ctx.font = 'bold 9px "Fredoka", sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('LYNKID', b.x + b.w / 2, signY + signH / 2 + 0.5);
  ctx.textAlign = 'start';
  ctx.textBaseline = 'alphabetic';

  // === Side windows ===
  const swSize = 11;
  const swY = drawY + 30;
  const swPadding = 7;
  // Left window
  ctx.fillStyle = 'rgba(45, 55, 72, 0.45)';
  roundRect(ctx, b.x + swPadding - 1, swY - 1, swSize + 2, swSize + 2, 2);
  ctx.fill();
  const winLit1 = ctx.createLinearGradient(0, swY, 0, swY + swSize);
  winLit1.addColorStop(0, '#FFE08A');
  winLit1.addColorStop(1, '#ED8936');
  ctx.fillStyle = winLit1;
  roundRect(ctx, b.x + swPadding, swY, swSize, swSize, 1.5);
  ctx.fill();
  // Right window
  ctx.fillStyle = 'rgba(45, 55, 72, 0.45)';
  roundRect(ctx, b.x + b.w - swPadding - swSize - 1, swY - 1, swSize + 2, swSize + 2, 2);
  ctx.fill();
  ctx.fillStyle = winLit1;
  roundRect(ctx, b.x + b.w - swPadding - swSize, swY, swSize, swSize, 1.5);
  ctx.fill();
  // Window crosses
  ctx.fillStyle = 'rgba(45, 55, 72, 0.4)';
  ctx.fillRect(b.x + swPadding + swSize/2 - 0.5, swY + 1, 1, swSize - 2);
  ctx.fillRect(b.x + swPadding + 1, swY + swSize/2 - 0.5, swSize - 2, 1);
  ctx.fillRect(b.x + b.w - swPadding - swSize/2 - 0.5, swY + 1, 1, swSize - 2);
  ctx.fillRect(b.x + b.w - swPadding - swSize + 1, swY + swSize/2 - 0.5, swSize - 2, 1);

  // === Front door ===
  const doorW = 26;
  const doorH = 28;
  const doorX = b.x + b.w / 2 - doorW / 2;
  const doorY = drawY + b.h - doorH - 2;

  // Door frame (darker outline)
  ctx.fillStyle = '#5A3A1C';
  roundRect(ctx, doorX - 2, doorY - 2, doorW + 4, doorH + 2, 4);
  ctx.fill();

  // Door body with wood gradient
  const doorGrad = ctx.createLinearGradient(doorX, doorY, doorX + doorW, doorY);
  doorGrad.addColorStop(0, '#D69E2E');
  doorGrad.addColorStop(0.5, '#ECC94B');
  doorGrad.addColorStop(1, '#B7791F');
  ctx.fillStyle = doorGrad;
  roundRect(ctx, doorX, doorY, doorW, doorH, 3);
  ctx.fill();

  // Door panels (vertical lines)
  ctx.strokeStyle = 'rgba(90, 58, 28, 0.5)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(doorX + doorW / 2, doorY + 4);
  ctx.lineTo(doorX + doorW / 2, doorY + doorH - 4);
  ctx.stroke();

  // Top arch detail
  ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';
  ctx.beginPath();
  ctx.moveTo(doorX + 3, doorY + 4);
  ctx.lineTo(doorX + doorW - 3, doorY + 4);
  ctx.lineTo(doorX + doorW - 3, doorY + 5);
  ctx.lineTo(doorX + 3, doorY + 5);
  ctx.closePath();
  ctx.fill();

  // Door knobs
  ctx.fillStyle = '#FFFAF0';
  ctx.beginPath();
  ctx.arc(doorX + doorW / 2 - 4, doorY + doorH / 2 + 4, 1.5, 0, Math.PI * 2);
  ctx.fill();
  ctx.beginPath();
  ctx.arc(doorX + doorW / 2 + 4, doorY + doorH / 2 + 4, 1.5, 0, Math.PI * 2);
  ctx.fill();

  // Step under door
  ctx.fillStyle = 'rgba(45, 55, 72, 0.5)';
  ctx.fillRect(doorX - 4, doorY + doorH, doorW + 8, 2);
}

function drawRoof(ctx, top, drawY) {
  const roofH = 22;
  const overhang = 4;

  // === Roof main triangle ===
  ctx.fillStyle = top.dark;
  ctx.beginPath();
  ctx.moveTo(top.x - overhang, drawY);
  ctx.lineTo(top.x + top.w / 2, drawY - roofH);
  ctx.lineTo(top.x + top.w + overhang, drawY);
  ctx.closePath();
  ctx.fill();

  // === Roof gradient highlight (left side) ===
  const roofGrad = ctx.createLinearGradient(top.x, drawY - roofH, top.x + top.w, drawY);
  roofGrad.addColorStop(0, 'rgba(255, 255, 255, 0.3)');
  roofGrad.addColorStop(0.5, 'rgba(255, 255, 255, 0.1)');
  roofGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
  ctx.fillStyle = roofGrad;
  ctx.beginPath();
  ctx.moveTo(top.x - overhang, drawY);
  ctx.lineTo(top.x + top.w / 2, drawY - roofH);
  ctx.lineTo(top.x + top.w + overhang, drawY);
  ctx.closePath();
  ctx.fill();

  // === Roof inner shadow (right side) ===
  ctx.fillStyle = 'rgba(45, 55, 72, 0.20)';
  ctx.beginPath();
  ctx.moveTo(top.x + top.w / 2, drawY - roofH);
  ctx.lineTo(top.x + top.w + overhang, drawY);
  ctx.lineTo(top.x + top.w / 2 + 1, drawY);
  ctx.closePath();
  ctx.fill();

  // === Roof bottom edge stripe ===
  ctx.fillStyle = 'rgba(45, 55, 72, 0.35)';
  ctx.fillRect(top.x - overhang, drawY - 1, top.w + overhang * 2, 2);

  // === Antenna pole ===
  ctx.strokeStyle = '#2D3748';
  ctx.lineWidth = 1.5;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(top.x + top.w / 2, drawY - roofH);
  ctx.lineTo(top.x + top.w / 2, drawY - roofH - 16);
  ctx.stroke();
  ctx.lineCap = 'butt';

  // === Flag pole top - peach ball ===
  ctx.fillStyle = '#FBD38D';
  ctx.beginPath();
  ctx.arc(top.x + top.w / 2, drawY - roofH - 17, 2.5, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = '#D69E2E';
  ctx.beginPath();
  ctx.arc(top.x + top.w / 2 - 0.5, drawY - roofH - 17.5, 1, 0, Math.PI * 2);
  ctx.fill();

  // === Pink flag with shadow ===
  ctx.fillStyle = 'rgba(45, 55, 72, 0.2)';
  ctx.beginPath();
  ctx.moveTo(top.x + top.w / 2 + 1.5, drawY - roofH - 14);
  ctx.lineTo(top.x + top.w / 2 + 12, drawY - roofH - 10);
  ctx.lineTo(top.x + top.w / 2 + 1.5, drawY - roofH - 5);
  ctx.closePath();
  ctx.fill();
  // Flag main
  ctx.fillStyle = '#ED64A6';
  ctx.beginPath();
  ctx.moveTo(top.x + top.w / 2 + 1, drawY - roofH - 15);
  ctx.lineTo(top.x + top.w / 2 + 11, drawY - roofH - 11);
  ctx.lineTo(top.x + top.w / 2 + 1, drawY - roofH - 6);
  ctx.closePath();
  ctx.fill();
  // Flag highlight
  ctx.fillStyle = '#F687B3';
  ctx.beginPath();
  ctx.moveTo(top.x + top.w / 2 + 1, drawY - roofH - 15);
  ctx.lineTo(top.x + top.w / 2 + 7, drawY - roofH - 12);
  ctx.lineTo(top.x + top.w / 2 + 1, drawY - roofH - 11);
  ctx.closePath();
  ctx.fill();
}

function drawCrane(ctx, W) {
  // Crane is a small fixed icon at top-center, not a full-width bar
  const cx = W / 2;
  const cy = CRANE_PIVOT_Y;

  // Crane horizontal arm (small, just enough to anchor cable)
  ctx.fillStyle = '#553C9A';
  roundRect(ctx, cx - 30, cy - 16, 60, 8, 4);
  ctx.fill();
  // Top highlight
  const armGrad = ctx.createLinearGradient(0, cy - 16, 0, cy - 8);
  armGrad.addColorStop(0, '#9F7AEA');
  armGrad.addColorStop(1, '#6B46C1');
  ctx.fillStyle = armGrad;
  roundRect(ctx, cx - 30, cy - 16, 60, 5, 3);
  ctx.fill();
  // Side support beams
  ctx.fillStyle = '#553C9A';
  roundRect(ctx, cx - 32, cy - 20, 6, 14, 2);
  ctx.fill();
  roundRect(ctx, cx + 26, cy - 20, 6, 14, 2);
  ctx.fill();
  // Center attachment point (where cable hangs)
  ctx.fillStyle = '#2D3748';
  ctx.beginPath();
  ctx.arc(cx, cy - 6, 3, 0, Math.PI * 2);
  ctx.fill();
  // Yellow light decoration
  ctx.fillStyle = '#FBD38D';
  ctx.beginPath();
  ctx.arc(cx - 18, cy - 12, 1.4, 0, Math.PI * 2);
  ctx.fill();
  ctx.beginPath();
  ctx.arc(cx + 18, cy - 12, 1.4, 0, Math.PI * 2);
  ctx.fill();
}

// Draw timer ring around the hanging block
function drawTimerRing(ctx, blockX, blockY, blockW, blockH) {
  // Frame hugging the block - rounded rectangle stroke that drains around perimeter
  const padding = 4; // distance from block edge
  const x = blockX - padding;
  const y = blockY - padding;
  const w = blockW + padding * 2;
  const h = blockH + padding * 2;
  const r = 10; // corner radius

  const elapsed = performance.now() - Game.timerStart;
  const remaining = Math.max(0, DROP_TIMER_MS - elapsed);
  const pct = remaining / DROP_TIMER_MS;

  // Compute total perimeter for the rounded rect
  const straightLen = (w - r * 2) * 2 + (h - r * 2) * 2;
  const cornerLen = Math.PI * 2 * r; // 4 quarter arcs = full circle
  const perimeter = straightLen + cornerLen;

  // Color based on remaining time
  let frameColor;
  if (remaining < 1500) {
    const pulse = 0.7 + 0.3 * Math.sin(performance.now() / 100);
    frameColor = `rgba(229, 62, 62, ${pulse})`;
  } else if (remaining < 3000) {
    frameColor = '#F6AD55';
  } else {
    frameColor = '#805AD5';
  }

  // Background frame (light track)
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.45)';
  ctx.lineWidth = 4;
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
  ctx.stroke();

  // Progress frame - use dash offset to "drain"
  // The stroke "drains" from the top-center counter-clockwise (visually shrinks)
  const visibleLen = perimeter * pct;
  const hiddenLen = perimeter - visibleLen;

  ctx.save();
  ctx.strokeStyle = frameColor;
  ctx.lineWidth = 5;
  ctx.lineCap = 'round';
  // setLineDash: [visible, gap]. Offset to start from top-center
  // Path starts at (x+r, y) which is top-left after corner. To start from top-middle,
  // we offset by -(w/2 - r) so the dash visible portion starts at top-center going clockwise.
  ctx.setLineDash([visibleLen, hiddenLen + 1]);
  ctx.lineDashOffset = -(w / 2 - r);

  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();

  // Glow when low time
  if (remaining < 3000) {
    ctx.shadowColor = frameColor;
    ctx.shadowBlur = 8;
  }
  ctx.stroke();
  ctx.restore();
}

function drawCloud(x, y, r) {
  const ctx = Game.ctx;
  ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';
  ctx.beginPath();
  ctx.arc(x, y, r, 0, Math.PI * 2);
  ctx.arc(x + r * 0.7, y - 4, r * 0.7, 0, Math.PI * 2);
  ctx.arc(x - r * 0.7, y - 1, r * 0.6, 0, Math.PI * 2);
  ctx.arc(x + r * 1.3, y + 3, r * 0.5, 0, Math.PI * 2);
  ctx.fill();
}

function drawCitySilhouette(ctx, cityY, W) {
  // Several flat-topped buildings as silhouette
  const buildings = [
    { x: 0, w: W * 0.12, h: 80 },
    { x: W * 0.1, w: W * 0.08, h: 100 },
    { x: W * 0.18, w: W * 0.12, h: 60 },
    { x: W * 0.6, w: W * 0.1, h: 90 },
    { x: W * 0.7, w: W * 0.08, h: 70 },
    { x: W * 0.78, w: W * 0.12, h: 110 },
    { x: W * 0.9, w: W * 0.1, h: 80 },
  ];
  buildings.forEach(b => {
    ctx.fillRect(b.x, cityY + (110 - b.h), b.w, b.h);
  });
}

function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

// ============================================================
// INIT
// ============================================================
loadState();
updateHomeBest();
renderSettings();
renderLeaderboard();
initCanvas();
requestAnimationFrame(render);

// Start splash boot sequence
bootApp();

// Prevent context menu
document.addEventListener('contextmenu', (e) => e.preventDefault());
